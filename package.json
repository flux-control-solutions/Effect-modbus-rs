{
  "name": "@flux-control/effect-modbus-rs",
  "version": "0.8.1",
  "description": "Type-safe Modbus communication via Effect-TS, wrapping the modbus-rs npm bindings.",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flux-control-solutions/Effect-modbus-rs.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf ./dist && bun build ./index.ts --outdir ./dist --target node --external effect --external modbus-rs && tsc --noEmit false --emitDeclarationOnly --outDir ./dist --rootDir . --project tsconfig.build.json",
    "changeset": "changeset",
    "docs": "bun install --cwd tools/typedoc --frozen-lockfile && bun run --cwd \"$PWD/tools/typedoc\" generate",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:staged": "lint-staged --config package.json",
    "lock": "bash tools/refresh-lockfile.sh",
    "prepare": "husky",
    "release": "changeset publish",
    "test": "bun test ./test/ ./examples/",
    "test:coverage": "bun test --coverage ./test/ ./examples/",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "modbus-rs": "0.16.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/language-service": "0.87.2",
    "@effect/platform-bun": "^4.0.0-rc.118",
    "@oxlint/plugins": "1.76.0",
    "@types/bun": "latest",
    "effect": "4.0.0-rc.118",
    "fallow": "^2.104.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "1.76.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.118"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,md,mdx,css,scss,html,yaml,yml}": "oxfmt"
  }
}
